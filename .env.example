# ─────────────────────────────────────────────
# Aibo Discord Bot — environment configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────

# Discord bot token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_token_here

# Hugging Face token — the same one the Nima/Arik/Zidan bots use
HUGGINGFACE_TOKEN=hf_your_token_here
# Tried in order until one answers. Use the same list as the Nima/Arik/Zidan bots.
# HF_MODELS=meta-llama/Llama-3.1-8B-Instruct
# (Mistral-7B-Instruct and zephyr-7b are "not a chat model" on HF's router - don't use them)
# HF_CALLS_PER_MIN=20
# Optional: separate (bigger) models just for understanding requests. Costs more credits.
# HF_INTENT_MODELS=meta-llama/Llama-3.3-70B-Instruct:fastest

# ── Voice listening ───────────────────────────
# Say "Milo, play K by Cigarettes After Sex" in voice chat.
VOICE_LISTEN=true
# Spellings speech-to-text might produce for the wake word (default follows BOT_NAME)
# WAKE_WORDS=milo,mylo,meelo
# Only react when a sentence starts with the bot's name ("Milo, play Iris").
# Everything else said in the call is ignored. Set false for the looser modes below.
VOICE_NAME_ONLY=true
# (only when VOICE_NAME_ONLY=false) While the bot is in your call, any phrase mentioning music ("bro stop this",
# "play ocean eyes", "turn it up") goes to the AI, which ignores it if it wasn't
# meant for the bot. Set false to always require the name.
VOICE_DIRECT_COMMANDS=true
# google = Google's free speech API, no key (default). Every phrase said in the
#          channel goes to Google, and heavy use can get rate-limited.
# local  = faster-whisper on this machine (pip install faster-whisper)
# hf     = Hugging Face Whisper (spends HF credits on every phrase)
STT_BACKEND=google
# en-IN understands Nepali-accented English best; ne-NP for Nepali
STT_LANGUAGE=en-IN
# Only for STT_BACKEND=local: tiny | base | small
# STT_LOCAL_MODEL=base

# ── Talking back ──────────────────────────────
# Answer spoken requests out loud in the voice channel
TTS_REPLY=true
# edge = natural Microsoft neural voices (free, no key) | gtts = Google Translate voice (pip install gTTS)
TTS_ENGINE=edge
# Any edge-tts voice: `edge-tts --list-voices`. Boys: en-US-BrianNeural (casual),
# en-CA-LiamNeural, en-GB-RyanNeural. Girls: en-US-AnaNeural (cute), en-GB-MaisieNeural.
TTS_VOICE=en-US-BrianNeural
# Devanagari Nepali replies
TTS_VOICE_NE=ne-NP-SagarNeural
# Speed and pitch: a little faster and higher makes Brian sound younger/cuter
TTS_RATE=+8%
TTS_PITCH=+15Hz
TTS_VOICE_NE=ne-NP-HemkalaNeural

# ── Music ─────────────────────────────────────
# On Oracle/any server YouTube may say "sign in to confirm you're not a bot".
# Export cookies.txt from a THROWAWAY logged-in YouTube account and point here.
# YTDLP_COOKIES=/home/ubuntu/aibo/cookies.txt
# When YouTube refuses, play the song from SoundCloud instead
SOUNDCLOUD_FALLBACK=true

# ── Bot settings ──────────────────────────────
# Name the bot calls itself AND the wake word
BOT_NAME=Milo
# Occasionally say something about a song when the queue moves on (max once per 20 min)
SONG_COMMENTS=true
# Max messages kept in per-guild conversation history
MAX_CONTEXT_MESSAGES=12
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
